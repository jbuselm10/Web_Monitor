# Copy this file to .env and fill in real values. Never commit .env.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GEMINI_API_KEY=your_gemini_api_key
AUTO_CHECK_INTERVAL_HOURS=6
AUTO_CHECK_MINUTE=30
MORNING_CHECK_ENABLED=true
MORNING_CHECK_HOUR=6
MORNING_CHECK_MINUTE=45
NOON_CHECK_ENABLED=true
NOON_CHECK_HOUR=12
NOON_CHECK_MINUTE=0

# Email alerts (recipients in email_recipients.txt)
EMAIL_ALERTS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=you@gmail.com
ALERT_EMAIL_SUBJECT=BuselWorks Daily Site Status Message
